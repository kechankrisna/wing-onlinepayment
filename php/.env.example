# Wing online payment UAT credentials, used by the integration tests (composer test).
# Copy to .env (never commit it) and fill in the values Wing gave you.
# the base URL Wing gave you, used as is (the staging host has no /wingonlinesdkv2)
WING_API_URL="https://sdk-uat.wingmoney.com/wingonlinesdkv2"
WING_USERNAME="provided by Wing"
WING_REST_API_KEY="provided by Wing"
WING_PASSWORD="provided by Wing"
WING_BILL_TILL_NUMBER="provided by Wing"
WING_REFERER_DOMAIN="the domain registered with Wing, e.g. https://example.com"
# "1" for UAT (default); "0" sends production requests and needs WING_ALLOW_PRODUCTION=true
WING_SANDBOX="1"
